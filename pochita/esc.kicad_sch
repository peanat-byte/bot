		)
		(uuid "4e54a2e5-910a-49bf-99aa-80cb3bc0f990")
	)
	(text_box "Voltage sensing\nMax 22.2V * 1k/11k = 2V"
		(exclude_from_sim no)
		(at 100.33 255.6271 0)
		(size 29.21 5.9929)
		(margins 0.9525 0.9525 0.9525 0.9525)
