		(uuid "6b97e1be-0003-40c3-a8c8-587e8b366583")
	)
	(text_box "36nC gate charge at 12VGS.\n250mA on/500mA off\n840ns on/420ns off\n= 210nC\nADC level 3 for both (R1: 30k, R2: 7.5k).\nSetting TCC voltage sets enable/input mode.\n"
		(exclude_from_sim no)
		(at 49.53 132.08 0)
		(size 43.18 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6c777340-7406-4a1f-bae0-c872e794bca1")
	)
	(text_box "Vout = 1.65 + Vin * (Rf/Rop)\nGain is 10k/1k = 10\nPeak current 55mA, 2mOhm shunt, so max 1.1V from bias voltage (within 0 - 3.3V ADC range). \nPower is (55mA / sqrt(2))^2 * 0.002Ohm = 3W"
		(exclude_from_sim no)
		(at 196.85 160.02 0)
		(size 50.8 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
